# Byte-compiled / cached Python files
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Coverage output (the text report in reports/ is committed)
.coverage
.coverage.*
coverage.xml
htmlcov/

# Logs
*.log

# IDEs and editors
.vscode/
.idea/
*.swp
.claude/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Local notes (not pushed)
docs/
